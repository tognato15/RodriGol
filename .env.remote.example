# RodriGol Studio RC2A — modelo de ambiente remoto
# NÃO coloque a senha real neste arquivo dentro de um repositório público.

HOST=0.0.0.0
PORT=4173
RODRIGOL_ENV=production

# Obrigatório para liberar /control/ quando o servidor estiver exposto.
RODRIGOL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Recomendado para integrações externas/OBS/portal.
RODRIGOL_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Em produção real, use o domínio HTTPS.
RODRIGOL_PUBLIC_URL=https://studio.seudominio.com
RODRIGOL_PUBLIC_WS=wss://studio.seudominio.com/ws
RODRIGOL_OVERLAY_URL=https://studio.seudominio.com/studio/

# Restrinja ao domínio do portal quando a API pública for criada.
RODRIGOL_ALLOWED_ORIGIN=https://seudominio.com

# Cookies Secure devem permanecer true atrás de HTTPS.
RODRIGOL_SECURE_COOKIES=true
RODRIGOL_SESSION_TTL_HOURS=12
