{
  "name": "rodrigol-2",
  "version": "2.2.2-rc.golive.1.1",
  "private": true,
  "description": "RodriGol Go-Live 1.1 — persistência central e jogos ao vivo multidiários.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "dev:overlay": "npm run dev -w @rodrigol/browser-overlay",
    "start": "npm run start -w @rodrigol/obs-bridge",
    "preview": "npm run start -w @rodrigol/browser-overlay",
    "dev:bridge": "npm run dev -w @rodrigol/obs-bridge",
    "start:overlay": "npm run start -w @rodrigol/browser-overlay",
    "dev:studio": "npm run dev -w @rodrigol/overlay-studio",
    "start:studio": "npm run start -w @rodrigol/overlay-studio",
    "preflight": "node scripts/preflight-operational.mjs",
    "start:remote": "node scripts/start-remote.mjs",
    "portal:check": "node --check apps/public-portal/public/app.js",
    "check:golive": "node scripts/check-golive.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
