# RodriGol Portal · Go-Live 1
# Railway define PORT automaticamente.

HOST=0.0.0.0
RODRIGOL_ENV=production
RODRIGOL_DATA_DIR=/data

# OBRIGATÓRIO: troque por uma senha forte antes de publicar.
RODRIGOL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Recomendado para integrações futuras.
RODRIGOL_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Enquanto usar o domínio temporário Railway, pode permanecer *.
# Quando o domínio final estiver configurado, restringiremos.
RODRIGOL_ALLOWED_ORIGIN=*

RODRIGOL_SECURE_COOKIES=true
RODRIGOL_SESSION_TTL_HOURS=12
RODRIGOL_OVERLAY_ROOT=studio
